{
  "type": "ShakeLabGroundMotion",
  "schema_version": "1.0.0",

  "metadata": {
    "name": "FVG ground-motion configuration",
    "description": "Ground-motion providers and asset assignments",
    "region": "Friuli Venezia Giulia",
    "date": "2026-08-24",
    "version": "1.0"
  },

  "providers": [
    {
      "id": "regional_gmpe",
      "provider": "gmpe",
      "default": true,

      "config": {
        "gmpe_name": "BragatoSlejko2005",
        "distance_approx": "ellipsoid"
      }
    },

    {
      "id": "official_shakemap",
      "provider": "shakemap",

      "config": {
        "path": "grid.xml",
        "interp": "bilinear"
      },

      "assignments": [
        {
          "assets": [
            "AGG_010",
            "AGG_011",
            "AGG_012"
          ]
        }
      ]
    },

    {
      "id": "observed_motion",
      "provider": "stations",

      "config": {
        "data_path": "observations"
      },

      "assignments": [
        {
          "assets": [
            "BLDG_001"
          ],

          "parameters": {
            "station_code": "UD01"
          }
        },

        {
          "assets": [
            "BLDG_002",
            "BLDG_003"
          ],

          "parameters": {
            "station_code": "UD02"
          }
        }
      ]
    }
  ]
}