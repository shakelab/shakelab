{
  "schema_version": "1.0.0",
  "paths": {
    "db": "./shakescenario.db",
    "workdir": "./runs",
    "model_root": "./models"
  },
  "server": {},
  "defaults": {
    "model_id": "ne_italy_default",
    "impact_config": {
      "uncertainty_mode": "lognormal",
      "output": "state",
      "typology_weighting": "count",
      "normalize_asset_probabilities": true,
      "missing_taxonomy": "raise",
      "no_damage_key": "D0",
      "include_typology_breakdown": true
    }
  }
}
